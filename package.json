{
  "name": "swinlearn-oop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "COS20007 Object-Oriented Programming: lessons, a C# engine and the diagrams, on your own machine.",
  "author": {
    "name": "SwinLearn OOP"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icon.mjs",
    "desktop:start": "npm run build && node scripts/start-desktop.mjs",
